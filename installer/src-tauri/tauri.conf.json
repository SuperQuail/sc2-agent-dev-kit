{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "开发套件安装器",
  "version": "0.1.0-a1",
  "identifier": "dev.superquail.devkit-installer",
  "build": {
    "frontendDist": "../ui/dist",
    "devUrl": "http://localhost:5184",
    "beforeDevCommand": "pnpm -C ../ui dev",
    "beforeBuildCommand": "pnpm -C ../ui build"
  },
  "app": {
    "windows": [
      {
        "title": "开发套件安装器",
        "width": 1000, "height": 780, "minWidth": 860, "minHeight": 620,
        "center": true, "resizable": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' asset: data:; style-src 'self' 'unsafe-inline'"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/icon.ico"]
  }
}
