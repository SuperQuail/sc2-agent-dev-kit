{
  "name": "sc2agent-installer",
  "version": "0.1.0-a1",
  "private": true,
  "description": "StarCraftIIAgent 安装器：把套件装到本机，并把技能交付给 DeepSeek Harness / Claude Code / Codex / opencode",
  "author": "扯蛋虾米",
  "license": "MIT",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "cli": "node cli.js",
    "detect": "node cli.js detect",
    "smoke": "electron . --smoke",
    "pack": "electron-packager . SC2Agent-Installer --platform=win32 --arch=x64 --out=dist-exe --overwrite --prune=true",
    "portable": "electron-builder --win portable"
  },
  "devDependencies": {
    "electron": "^33.0.0",
    "electron-builder": "^25.0.0"
  },
  "build": {
    "appId": "com.sc2agent.installer",
    "productName": "SC2Agent-Installer",
    "directories": { "output": "dist-portable" },
    "files": [
      "main.js", "preload.js", "cli.js", "lib/**/*", "renderer/**/*", "package.json", "README.md"
    ],
    "win": {
      "target": [{ "target": "portable", "arch": ["x64"] }],
      "artifactName": "SC2Agent-Installer-${version}.exe"
    },
    "portable": { "artifactName": "SC2Agent-Installer-${version}.exe" }
  }
}