# 发布与分发构建产物（禁止就地编辑）
publish/

# 打包输出（tools/package.py 生成，收件人自行解压）
dist/

# PyInstaller 构建中间产物（tools/build-updater-exe.py）
build/

# Rust 构建产物（约 2 GB，cargo build --release 重建）
installer/target/

# 本地缓存与临时文件
__pycache__/
*.pyc
*.pyo
*.pyd
.pytest_cache/
.DS_Store
Thumbs.db

# 生成的 catalog 索引（可用 tools/build-sc2-catalog-graph.py 重建）
sc2-catalog-graph-out/

# 暴雪游戏数据导出（166 MB / 2490 文件）。
# 不是本项目的代码，不作为本仓库内容分发——用户从 release 的 data.zip 获取，
# 安装器按哈希判断是否需要应用。tools/release.py 仍从本地磁盘读取它来构建该包。
DataEditorXML/

# 本地试玩提取日志
bugreport.txt

# 本地备份与临时工作文件
backups/
tmp/
.sc2-reference-stage-*/
.sc2-reference-backup-*/

# 本机路径配置（不同机器路径不同，不进版本库）
agent-config.json

# Workspace reset recovery archive
.workspace-recovery/

# Generated validation reports and staged publication/previous versions
reports/
**/.*.stage-*/
**/.*.sc2-previous/
**/.*.sc2-previous.owner.json
**/.*.sc2-retired-*/
**/.*.sc2-publish.lock/
